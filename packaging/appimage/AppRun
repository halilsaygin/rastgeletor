#!/bin/sh
# AppRun - Portable Application Launcher for Pardus ETAP & Linux Desktops
set -e

HERE="$(dirname "$(readlink -f "${0}")")"

# Export library and data paths
export PATH="${HERE}/usr/bin:${PATH}"
export LD_LIBRARY_PATH="${HERE}/usr/lib:${HERE}/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH}"
export PYTHONPATH="${HERE}/usr/share/rastgeletor:${PYTHONPATH}"
export XDG_DATA_DIRS="${HERE}/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# Touchscreen and HiDPI defaults for interactive whiteboards
export GDK_SCALE="${GDK_SCALE:-1}"
export GDK_DPI_SCALE="${GDK_DPI_SCALE:-1}"

# Use bundled python if present, else fallback to host python3
if [ -x "${HERE}/usr/bin/python3" ]; then
    PYTHON_BIN="${HERE}/usr/bin/python3"
else
    PYTHON_BIN="$(command -v python3 2>/dev/null || echo /usr/bin/python3)"
fi

exec "$PYTHON_BIN" -m app.main "$@"
